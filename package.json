{
  "name": "docky",
  "displayName": "Docky - Documentation Companion",
  "description": "Keep your code documentation organized with beautiful side-by-side markdown viewing. Works with all languages - JavaScript, TypeScript, Python, Java, Dart, and more!",
  "version": "1.1.9",
  "publisher": "ahadjonovss",
  "author": {
    "name": "Samandar Ahadjonov",
    "email": "samandarahadjonov@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ahadjonovss/vscode-docs-extension.git"
  },
  "bugs": {
    "url": "https://github.com/ahadjonovss/vscode-docs-extension/issues"
  },
  "homepage": "https://github.com/ahadjonovss/vscode-docs-extension#readme",
  "keywords": [
    "documentation",
    "markdown",
    "docs",
    "comments",
    "notes",
    "readme",
    "viewer",
    "side-by-side",
    "breadcrumb",
    "dart",
    "flutter",
    "javascript",
    "typescript",
    "python",
    "java",
    "go",
    "rust"
  ],
  "icon": "assets/images/logo.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "docky.openDocumentation",
        "title": "Open Documentation with Docky",
        "icon": {
          "light": "assets/images/icon.png",
          "dark": "assets/images/icon.png"
        }
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "docky.openDocumentation",
          "when": "editorIsOpen && !activeEditor.isReadonly",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/markdown-it": "^13.0.7",
    "@types/mocha": "^10.0.1",
    "@types/node": "16.x",
    "@types/vscode": "^1.75.0",
    "@typescript-eslint/eslint-plugin": "^5.59.1",
    "@typescript-eslint/parser": "^5.59.1",
    "@vscode/test-electron": "^2.3.0",
    "eslint": "^8.39.0",
    "glob": "^8.1.0",
    "mocha": "^10.2.0",
    "typescript": "^5.0.4"
  },
  "dependencies": {
    "markdown-it": "^13.0.2"
  }
}
